# Initial password for 9router admin UI
INITIAL_PASSWORD=

# JWT secret for 9router
# Generate with: openssl rand -hex 16 | head -c 32
JWT_SECRET=

# API key secret for 9router
# Generate with: openssl rand -base64 32 | tr -dc 'a-zA-Z0-9' | head -c 32
API_KEY_SECRET=

# Machine ID salt for 9router
# Generate with: openssl rand -base64 16 | tr -dc 'a-zA-Z0-9' | head -c 16
MACHINE_ID_SALT=
